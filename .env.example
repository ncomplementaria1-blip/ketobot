# API de Anthropic (Claude)
# Obtener en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# API de WhatsApp Business (Meta)
# Obtener al configurar la app en developers.facebook.com
WHATSAPP_TOKEN=EAAxxxxxxxxx
WHATSAPP_PHONE_ID=1234567890

# Token de verificación (puedes poner cualquier palabra secreta)
VERIFY_TOKEN=ketooficial2024

# Ruta al archivo SQLite donde se guarda el historial de conversaciones
SQLITE_PATH=ketobot.db

# Cuántos mensajes del historial enviar a Claude en cada request
HISTORY_LIMIT=10

# Meta Conversions API (CAPI) — para mandar evento Purchase y optimizar ads por compras
# Events Manager → Configuración → API de conversiones → Generar token de acceso
META_DATASET_ID=123456789012345
META_CAPI_TOKEN=EAA...

# Token para proteger /admin/sale (genera uno aleatorio, mínimo 32 chars)
ADMIN_TOKEN=cambia-esto-por-un-token-aleatorio-largo

# Credenciales para facebook_navigate.py (cambio de número WhatsApp en la Página)
FB_EMAIL=tu-email@ejemplo.com
FB_PASSWORD=tu-password
FB_PAGE_NAME=Keto Oficial Chile Y Mundo
NEW_WA_NUMBER=+56936475173
OLD_WA_NUMBER=+56940744890
ROUTE=A
